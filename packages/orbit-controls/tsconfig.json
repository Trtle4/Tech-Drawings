{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "outDir": "dist",
    "noEmit": false,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src/orbitControls.ts"]
}
